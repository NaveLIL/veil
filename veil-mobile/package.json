{
  "name": "veil-mobile",
  "version": "0.1.0",
  "private": true,
  "author": "NaveLIL",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://veil.erez.pro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NaveLIL/veil.git",
    "directory": "veil-mobile"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "native:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-native.ps1",
    "verify:android-production-bundle": "node scripts/verify-android-production-bundle.mjs",
    "verify:android-tester-apk": "node scripts/verify-android-tester-apk.mjs",
    "test:android-tester-apk-verifier": "node --test scripts/verify-android-tester-apk.test.mjs",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@react-navigation/native": "^7",
    "@react-navigation/native-stack": "^7",
    "expo": "~53.0.0",
    "expo-blur": "~14.1.5",
    "expo-linear-gradient": "~14.1.5",
    "expo-secure-store": "~14.2.4",
    "expo-status-bar": "~2.2.0",
    "expo-system-ui": "~5.0.11",
    "lucide-react-native": "^1.25.0",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-pager-view": "6.7.1",
    "react-native-reanimated": "~3.17.0",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.0",
    "react-native-svg": "15.11.2",
    "zustand": "^5"
  },
  "devDependencies": {
    "@jest/globals": "^29",
    "@testing-library/react-native": "13.3.3",
    "@types/react": "~19.0.10",
    "@types/react-test-renderer": "19.0.0",
    "babel-preset-expo": "~13.0.0",
    "eslint": "^9.18.0",
    "eslint-config-expo": "~9.2.0",
    "jest": "^29",
    "jest-expo": "~53.0.0",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.0"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "transformIgnorePatterns": [
      "node_modules[\\\\/](?!(?:\\.pnpm[\\\\/][^\\\\/]+[\\\\/]node_modules[\\\\/])?(?:(?:jest-)?react-native(?:[\\\\/]|$)|@react-native(?:[\\\\/]|$)|expo[^\\\\/]*(?:[\\\\/]|$)|@expo(?:nent)?(?:[\\\\/]|$)|react-navigation(?:[\\\\/]|$)|@react-navigation(?:[\\\\/]|$)|react-native-svg(?:[\\\\/]|$)|lucide-react-native(?:[\\\\/]|$)))"
    ]
  }
}

* text=auto

# These files execute inside Linux containers even when the repository is
# checked out on Windows. CRLF would make /bin/sh and Docker entrypoints fail.
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
/test-vectors/direct-v1/*.json text eol=lf
/test-vectors/direct-v1/SHA256SUMS text eol=lf

# Windows-native scripts should keep the platform convention.
*.ps1 text eol=crlf

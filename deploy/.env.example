# Copy to deploy/.env, keep it mode 0600, and fill every required empty value.

# Immutable image produced by the release workflow. A tag is not sufficient.
VEIL_GATEWAY_IMAGE=ghcr.io/navelil/veil-gateway@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
VEIL_RELEASE_ID=replace-with-release-tag-or-git-sha

# Use exactly URL-safe hexadecimal characters because this value is embedded
# into DATABASE_URL by Compose. Generate with: openssl rand -hex 32
VEIL_DB_PASSWORD=

VEIL_GATEWAY_PORT=9080
VEIL_WS_ORIGINS=https://veil.erez.pro
VEIL_CORS_ORIGINS=https://veil.erez.pro
VEIL_WS_MAX_CONNS_PER_IP=64
# Keep false until the operator identity, privacy details, and public launch
# readiness have been reviewed. Existing accounts can still authenticate.
VEIL_ALLOW_REGISTRATION=false
VEIL_INTERNAL_ADDR=off

# Leave empty for an official image, whose revision is embedded by CI. A
# modified image must set all three to its exact public Corresponding Source.
VEIL_SOURCE_REVISION=
VEIL_SOURCE_ARCHIVE_URL=
VEIL_SOURCE_BROWSE_URL=

# Generate with: openssl rand -base64 32
VEIL_UPLOAD_TOKEN_KEY=
UPLOAD_MAX_BYTES=2147516416
UPLOAD_USER_DAILY_QUOTA_BYTES=5368709120
UPLOAD_QUOTA_WINDOW=24h
UPLOAD_RETENTION=720h
UPLOAD_ABORT_TTL=24h
UPLOAD_SWEEP_INTERVAL=1h
UPLOAD_TOKEN_TTL=24h

# Optional Web Push. Leave both empty to disable it.
VEIL_PUSH_VAPID_PRIVATE_KEY=
VEIL_PUSH_VAPID_SUBJECT=
VEIL_PUSH_JITTER_MS=2000
VEIL_PUSH_ALLOWED_PRIVATE_ORIGINS=http://ntfy:80

# Infrastructure images are explicit and should be updated through reviewed PRs.
VEIL_POSTGRES_IMAGE=postgres:16.14-alpine3.24
VEIL_NTFY_IMAGE=binwiederhier/ntfy:v2.23.0

# Used only with: docker compose --profile push ...
VEIL_NTFY_PORT=9081
VEIL_NTFY_BASE_URL=https://push.veil.erez.pro

# Generate with: openssl rand -hex 32
VEIL_DB_PASSWORD=replace-with-a-random-64-character-hex-secret

# Exact browser origins allowed to initiate WebSocket upgrades.
VEIL_WS_ORIGINS=https://veil.erez.pro
# Optional REST CORS allow-list. Native clients do not require CORS.
VEIL_CORS_ORIGINS=https://veil.erez.pro

# Compose's gateway is reachable through Caddy. Set false when exposing the
# gateway directly; alternatively configure VEIL_TRUSTED_PROXY_CIDRS.
VEIL_TRUST_PROXY_HEADERS=true

# Required only when the `proxy` compose profile is enabled.
VEIL_PUBLIC_HOST=veil.erez.pro
VEIL_TLS_EMAIL=admin@example.com

# Optional services. Generate a VAPID key with:
#   cd veil-server && go run ./cmd/vapid-keygen
VEIL_PUSH_VAPID_PRIVATE_KEY=
VEIL_PUSH_VAPID_SUBJECT=mailto:admin@example.com
VEIL_PUSH_ALLOWED_PRIVATE_ORIGINS=http://ntfy:80
VEIL_UPLOAD_TOKEN_KEY=

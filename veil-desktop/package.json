{
  "name": "veil-desktop",
  "private": true,
  "version": "0.1.2",
  "author": "NaveLIL",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://veil.erez.pro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NaveLIL/veil.git",
    "directory": "veil-desktop"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:bundle": "pnpm licenses:desktop && pnpm build",
    "licenses:desktop": "node ../scripts/generate-third-party-notices.mjs --component desktop --output src-tauri/resources/THIRD_PARTY_NOTICES.txt",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:a11y": "vitest run src/test/a11y-smoke.test.tsx",
    "test:visual": "playwright test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.11",
    "@solidjs/router": "^0.15",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-os": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-solid": "^1.7.0",
    "solid-js": "^1.9",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.7",
    "vite": "^6.4.3",
    "vite-plugin-solid": "^2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "postcss": "8.5.10"
    }
  }
}
